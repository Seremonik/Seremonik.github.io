{{ define "main" }}
<style>
section.prose {
  max-width: 100% !important;
  display: flex;
  justify-content: center;
}

.about-page {
  max-width: 960px;
  width: 100%;
  margin: 0 auto;
  padding: 2rem 0;
}

.about-two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: center;
}

@media (max-width: 640px) {
  .about-two-col { grid-template-columns: 1fr; }
}

.about-hero { margin-bottom: 3rem; }

.about-col-left {
  display: flex;
  justify-content: center;
  align-items: center;
}

.about-avatar {
  width: 330px;
  height: 330px;
  border-radius: 50%;
  object-fit: cover;
  border: 3px solid rgb(var(--color-primary-400));
  box-shadow: 0 0 32px rgba(var(--color-primary-500), 0.3);
}

.about-col-right h1 {
  margin: 0 0 1.25rem 0;
  font-size: 2rem;
  font-weight: 800;
}

.about-headline {
  color: rgb(var(--color-primary-400));
  font-weight: 600;
  margin: 0 0 0.5rem 0;
  font-size: 1.1rem;
}

.about-tagline {
  margin: 0 0 1rem 0;
  opacity: 0.75;
}

.about-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1.25rem;
}

.about-badge {
  background: rgba(var(--color-primary-500), 0.15);
  color: rgb(var(--color-primary-400));
  border: 1px solid rgba(var(--color-primary-400), 0.3);
  border-radius: 999px;
  padding: 0.2rem 0.75rem;
  font-size: 0.8rem;
  font-weight: 600;
}

.about-bio p {
  margin-bottom: 0.75rem;
  line-height: 1.7;
  opacity: 0.85;
}

.about-section { margin-bottom: 3rem; }

.about-section-title {
  font-size: 1.3rem;
  font-weight: 700;
  margin-bottom: 1.25rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(var(--color-primary-400), 0.3);
  color: rgb(var(--color-primary-400));
}

.about-project-card {
  background: rgba(var(--color-neutral-800), 0.4);
  border: 1px solid rgba(var(--color-neutral-600), 0.4);
  border-radius: 1rem;
  overflow: hidden;
  margin-bottom: 1.5rem;
}

.about-project-info {
  padding: 1.5rem;
}

.about-project-info h3 {
  margin: 0 0 0.75rem 0;
  font-size: 1.1rem;
  font-weight: 700;
}

.about-project-info p {
  margin: 0;
  opacity: 0.85;
  line-height: 1.7;
}

.about-media-wrapper {
  height: 100%;
  min-height: 220px;
  overflow: hidden;
}

.about-media-wrapper video,
.about-project-image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

/* Carousel */
.carousel {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.carousel-track {
  display: flex;
  height: 100%;
  transition: transform 0.4s ease;
}

.carousel-slide {
  min-width: 100%;
  flex-shrink: 0;
}

.carousel-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(0,0,0,0.45);
  color: #fff;
  border: none;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-size: 1.4rem;
  line-height: 1;
  cursor: pointer;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.carousel-btn:hover { background: rgba(0,0,0,0.7); }
.carousel-prev { left: 8px; }
.carousel-next { right: 8px; }

.carousel-dots {
  position: absolute;
  bottom: 8px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 6px;
}

.carousel-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(255,255,255,0.4);
  cursor: pointer;
  transition: background 0.2s;
}

.carousel-dot.active { background: #fff; }

/* Contact */
.about-contact {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.about-contact-links {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.about-contact-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  background: rgba(var(--color-primary-500), 0.15);
  color: rgb(var(--color-primary-400));
  border: 1px solid rgba(var(--color-primary-400), 0.4);
  border-radius: 0.5rem;
  text-decoration: none;
  transition: background 0.2s, color 0.2s;
}

.about-contact-btn:hover {
  background: rgb(var(--color-primary-500));
  color: #fff;
}

/* Newsletter */
.about-newsletter {
  background: rgba(var(--color-neutral-800), 0.4);
  border: 1px solid rgba(var(--color-neutral-600), 0.4);
  border-radius: 1rem;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.about-newsletter p {
  margin: 0;
  opacity: 0.85;
  line-height: 1.6;
  flex: 1;
}

.about-newsletter-btn {
  background: rgb(var(--color-primary-500));
  color: #fff;
  border: none;
  border-radius: 0.5rem;
  padding: 0.5rem 1.5rem;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.2s;
}

.about-newsletter-btn:hover {
  background: rgb(var(--color-primary-600));
}

</style>

